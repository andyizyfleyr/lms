# Copie ce fichier en .env.local et colle ta chaîne de connexion Neon.
# Console Neon → ton projet → « Connect » → Connection string (avec pooling).
DATABASE_URL="postgresql://user:motdepasse@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Sel utilisé pour signer les jetons de session (mets une longue chaîne aléatoire).
AUTH_SECRET="change-moi-par-une-longue-chaine-aleatoire"
