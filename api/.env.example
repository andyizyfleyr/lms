# Copie ce fichier en .env.local et colle ta chaîne de connexion Neon.
# Console Neon → ton projet → « Connect » → Connection string (avec pooling).
DATABASE_URL="postgresql://user:motdepasse@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Sel utilisé pour signer les jetons de session (mets une longue chaîne aléatoire).
AUTH_SECRET="change-moi-par-une-longue-chaine-aleatoire"

# --- Cours payants : NOVA Checkout (https://nova-azure-psi.vercel.app/docs) ---
# Clé marchande affichée une seule fois : NOVA → Paramètres → Intégration marchande.
NOVA_SECRET_KEY="sk_live_…"
# Secret du webhook : NOVA → Webhook (la valeur n'est affichée qu'à la création).
NOVA_WEBHOOK_SECRET="whsec_…"
# Adresse de retour après paiement — NOVA exige HTTPS (http://localhost est refusé).
SITE_URL="https://lms-lovat-five.vercel.app"
